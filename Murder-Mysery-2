-- ИСПРАВЛЕННЫЙ И ЗАВЕРШЕННЫЙ БЛОК Modules.ShootMurdererOnce
-- ============================================================================
function Modules.ShootMurdererOnce()
    local localplayer = Modules.Player
    if not localplayer or not localplayer.Character then return end
    
    local target = Modules.FindMurderer() or Modules.FindSheriffThatsNotMe()
    if not target or not target.Character then return end

    local targetPos = Modules.getPredictedPosition(target)
    local gun = localplayer.Character:FindFirstChild("Gun") or (localplayer:FindFirstChild("Backpack") and localplayer.Backpack:FindFirstChild("Gun"))
    
    if gun then
        if gun.Parent == localplayer.Backpack then
            gun.Parent = localplayer.Character
        end
        
        local knifeServer = gun:FindFirstChild("KnifeServer") or gun:FindFirstChild("Shoot")
        if knifeServer and knifeServer:IsA("RemoteEvent") then
            knifeServer:FireServer(CFrame.new(localplayer.Character.HumanoidRootPart.Position, targetPos))
        end
    end
end

return Modules
