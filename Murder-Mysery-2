local function checkPlayerCoinBag()
    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return collectedInBag end

    local mainGui = playerGui:FindFirstChild("MainGUI")
    if not mainGui then return collectedInBag end

    local gameFrame = mainGui:FindFirstChild("Game")
    if not gameFrame then return collectedInBag end

    local coinBag = gameFrame:FindFirstChild("CoinBag")
    if not coinBag then return collectedInBag end

    local amountLabel = coinBag:FindFirstChild("Amount")
    if amountLabel and amountLabel:IsA("TextLabel") then
        local currentText = amountLabel.Text
        local current, maxVal = string.match(currentText, "(%d+)%s*/%s*(%d+)")
        if current then
            local numCurrent = tonumber(current) or 0
            local numMax = tonumber(maxVal) or maxBagCapacity
            maxBagCapacity = numMax
            collectedInBag = numCurrent
            return collectedInBag
        end
    end

    return collectedInBag
end

local function getActiveCoinContainer()
