local function collectAllCoinsInMap()
    local container = getActiveCoinContainer()
    if not container then return {} end

    local coins = {}
    for _, item in ipairs(container:GetChildren()) do
        if item:IsA("BasePart") then
            table.insert(coins, item)
        elseif item:IsA("Model") then
            local primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
            if primary then
                table.insert(coins, primary)
            end
        end
    end
    return coins
end

local function findNearestCoin(hrpPosition)
    local coins = collectAllCoinsInMap()
    local nearest = nil
    local shortestDist = math.huge

    for _, coinPart in ipairs(coins) do
        if coinPart and coinPart.Parent then
            local dist = (coinPart.Position - hrpPosition).Magnitude
            if dist <= MAX_FARM_DISTANCE and dist < shortestDist then
                shortestDist = dist
                nearest = coinPart
            end
        end
    end
    return nearest
end

local function touchCoinDirect(hrp, coinPart)
    if not fireTouch or not hrp or not coinPart then return end

    pcall(function()
        fireTouch(hrp, coinPart, 0)
        task.wait(0.02)
        fireTouch(hrp, coinPart, 1)
    end)
end

