local holder = create("Frame", {
    Name = "Holder",
    AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundTransparency = 1,
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
}, screenGui)

local responsiveScale = create("UIScale", { Scale = 1 }, holder)
local statsScale = nil

local function isPhoneScreen()
    local camera = workspace.CurrentCamera
    return camera and UserInputService.TouchEnabled and camera.ViewportSize.Y <= 620
end

local function updateScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local scale = math.min((viewport.X - 28) / WINDOW_WIDTH, (viewport.Y - 28) / WINDOW_HEIGHT)
    local minScale = 0.58
    if isPhoneScreen() then
        scale = math.min(scale, (viewport.Y * 0.74) / WINDOW_HEIGHT)
        minScale = 0.4
    end
    responsiveScale.Scale = math.clamp(scale, minScale, 1)
    if statsScale then
        statsScale.Scale = isPhoneScreen() and math.clamp((viewport.Y * 0.42) / 202, 0.55, 1) or 1
    end
end

local function clampWindow()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local scale = responsiveScale.Scale
    local visibleHeight = (state.minimized and COLLAPSED_HEIGHT or WINDOW_HEIGHT) * scale
    local halfWidth = WINDOW_WIDTH * scale * 0.5
    local fullHalfHeight = WINDOW_HEIGHT * scale * 0.5

    local position = holder.Position
    local centerX = position.X.Scale * viewport.X + position.X.Offset
    local centerY = position.Y.Scale * viewport.Y + position.Y.Offset

    centerX = math.clamp(centerX, halfWidth + 8, math.max(halfWidth + 8, viewport.X - halfWidth - 8))
    centerY = math.clamp(centerY, fullHalfHeight + 8, math.max(fullHalfHeight + 8, viewport.Y - visibleHeight + fullHalfHeight - 8))
    holder.Position = UDim2.fromOffset(centerX, centerY)
end

local function refreshViewport()
    updateScale()
    clampWindow()
end

local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera = workspace.CurrentCamera
    if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshViewport) end
    refreshViewport()
end

