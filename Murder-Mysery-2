-- Autofarm utility functions
local function isCoinPart(coin)
    if not coin:IsA("BasePart") then return false end
    if string.find(coin.Name, "Server", 1, true) then return true end
    if Modules.Autofarm.detectedPickupNames[coin.Name] then return true end
    return Modules.Autofarm.lenientContainers[coin.Parent] == true
end

local function registerCoin(coin)
    if isCoinPart(coin) then
        Modules.Autofarm.coinSet[coin] = true
    end
end

local function unregisterCoin(coin)
    Modules.Autofarm.coinSet[coin] = nil
    Modules.Autofarm.coinBlacklist[coin] = nil
    Modules.Autofarm.coinTouchFails[coin] = nil
    Modules.Autofarm.deadCoins[coin] = nil
    Modules.Autofarm.coinHadVisual[coin] = nil
end

local function watchContainer(container)
    if Modules.Autofarm.trackedContainers[container] then return end
    Modules.Autofarm.trackedContainers[container] = true
    AddConnection(container.ChildAdded:Connect(registerCoin))
    AddConnection(container.ChildRemoved:Connect(unregisterCoin))
    for _, coin in ipairs(container:GetChildren()) do
        registerCoin(coin)
    end
end

local function radarSweep(force)
    if not force and os.clock() - Modules.Autofarm.lastRadarSweep < 3 then return end
    Modules.Autofarm.lastRadarSweep = os.clock()

    for container in pairs(Modules.Autofarm.trackedContainers) do
        if not container.Parent then
            Modules.Autofarm.trackedContainers[container] = nil
        end
    end
    
    for coin in pairs(Modules.Autofarm.coinSet) do
        if not coin.Parent then
            unregisterCoin(coin)
        end
    end
    
    for _, containerParent in ipairs(Workspace:GetChildren()) do
        local container = containerParent:FindFirstChild("CoinContainer")
        if container then
            watchContainer(container)
        end
        for _, child in ipairs(containerParent:GetChildren()) do
            if child ~= container
                and not Modules.Autofarm.trackedContainers[child]
                and string.find(child.Name, "Container", 1, true) then
                local part = child:FindFirstChildWhichIsA("BasePart")
                if part and string.find(part.Name, "Server", 1, true) then
                    watchContainer(child)
                end
            end
        end
    end

    for container in pairs(Modules.Autofarm.trackedContainers) do
        if container.Parent and not Modules.Autofarm.lenientContainers[container] then
            local hasKnown = false
            local hasParts = false
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("BasePart") then
                    hasParts = true
                    if string.find(child.Name, "Server", 1, true) then
                        hasKnown = true
                        break
                    end
                end
            end
            if hasParts and not hasKnown then
                Modules.Autofarm.lenientContainers[container] = true
                for _, child in ipairs(container:GetChildren()) do
                    registerCoin(child)
                end
            end
        end
    end
end

local function findClosestItem(rootPart)
    local now = os.clock()

    if now - Modules.Autofarm.lastPickTime < 0.15 then
        if not Modules.Autofarm.lastPickHadResult then
            return nil, math.huge, math.huge
        end
        local cached = Modules.Autofarm.lastPickCoin
        if cached and cached.Parent and not Modules.Autofarm.coinBlacklist[cached] and not Modules.Autofarm.deadCoins[cached] then
            return cached, (cached.Position - rootPart.Position).Magnitude, Modules.Autofarm.lastPickScore
        end
    end
    Modules.Autofarm.lastPickTime = now

    for coin, timestamp in pairs(Modules.Autofarm.coinBlacklist) do
        if not coin.Parent or now - timestamp > 1.5 then
            Modules.Autofarm.coinBlacklist[coin] = nil
        end
    end

    radarSweep(false)

    local candidates = {}
    for coin in pairs(Modules.Autofarm.coinSet) do
        if coin.Parent and not Modules.Autofarm.coinBlacklist[coin] and not Modules.Autofarm.deadCoins[coin] then
            local childCount = #coin:GetChildren()
            if childCount > 0 then
                Modules.Autofarm.coinHadVisual[coin] = true
                table.insert(candidates, coin)
            elseif not Modules.Autofarm.coinHadVisual[coin] then
                table.insert(candidates, coin)
            end
        end
    end

    local count = #candidates
    if count == 0 then
        Modules.Autofarm.lastPickHadResult = false
        return nil, math.huge, math.huge
    end

    local rootPosition = rootPart.Position
    local positions = table.create(count)
    local distances = table.create(count)
    local order = table.create(count)
    for index = 1, count do
        local position = candidates[index].Position
        positions[index] = position
        distances[index] = (position - rootPosition).Magnitude
        order[index] = index
    end
    table.sort(order, function(a, b)
        return distances[a] < distances[b]
    end)

    local best, bestDistance, bestScore = nil, math.huge, math.huge
    local maxBonus = 6 * Modules.Autofarm.clusterBonus
    for _, index in ipairs(order) do
        local distance = distances[index]
        if distance - maxBonus >= bestScore then
            break
        end
        local position = positions[index]
        local neighbors = 0
        for otherIndex = 1, count do
            if otherIndex ~= index and (positions[otherIndex] - position).Magnitude <= Modules.Autofarm.clusterRadius then
                neighbors += 1
                if neighbors >= 6 then
                    break
                end
            end
        end
        local score = distance - neighbors * Modules.Autofarm.clusterBonus
        if score < bestScore then
            best = candidates[index]
            bestDistance = distance
            bestScore = score
        end
    end

    Modules.Autofarm.lastPickCoin = best
    Modules.Autofarm.lastPickScore = bestScore
    Modules.Autofarm.lastPickHadResult = best ~= nil

    return best, bestDistance, bestScore
end

local function restoreCharacter()
    pcall(function()
        Player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Default
    end)

    local character = Player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end

    for part, oldCanCollide in pairs(Modules.Autofarm.collisionCache) do
        if part and part.Parent then
            part.CanCollide = oldCanCollide
        end
    end
    table.clear(Modules.Autofarm.collisionCache)
end

local function isRoundOver()
    local guiParent = Player:FindFirstChildWhichIsA("PlayerGui")
    if not guiParent then return false end
    
    for _, guiName in ipairs({ "Scoreboard", "Scoreboard_Phone" }) do
        local scoreboard = guiParent:FindFirstChild(guiName)
        if scoreboard and scoreboard:IsA("ScreenGui") and scoreboard.Enabled then
            for _, modeFrame in ipairs(scoreboard:GetChildren()) do
                if modeFrame:IsA("GuiObject") and modeFrame.Visible then
                    return true
                end
            end
        end
    end
    return false
end

local function startAutofarm()
    if Modules.Autofarm.farmConnection then
        Modules.Autofarm.farmConnection:Disconnect()
    end
    
    radarSweep(true)
    Modules.Autofarm.farmConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not Modules.Autofarm.enabled then return end

        local character = Player.Character
        if not character then
            Modules.Autofarm.farmPaused = true
            Modules.Autofarm.pauseReason = "RESPAWN"
            return
        end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            Modules.Autofarm.farmPaused = true
            Modules.Autofarm.pauseReason = "RESPAWN"
            return
        end

        if isRoundOver() then
            Modules.Autofarm.currentTarget = nil
            Modules.Autofarm.farmPaused = true
            Modules.Autofarm.pauseReason = "ROUND END"
            restoreCharacter()
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            return
        end

        Modules.Autofarm.farmPaused = false
        Modules.Autofarm.pauseReason = ""

        if not Modules.Autofarm.currentTarget or not Modules.Autofarm.currentTarget.Parent then
            local target, distance = findClosestItem(rootPart)
            if target and distance <= Modules.Autofarm.maxFarmDistance then
                Modules.Autofarm.currentTarget = target
            else
                Modules.Autofarm.currentTarget = nil
            end
        end

        if Modules.Autofarm.currentTarget then
            local targetPos = Modules.Autofarm.currentTarget.Position
            local direction = (targetPos - rootPart.Position).Unit
            rootPart.AssemblyLinearVelocity = direction * Modules.Autofarm.farmSpeed
            
            if Modules.Autofarm.fireTouch then
                pcall(function()
                    Modules.Autofarm.fireTouch(Modules.Autofarm.currentTarget, Modules.Autofarm.fireTouch)
                end)
            end
        end
    end)
end

local function stopAutofarm()
    if Modules.Autofarm.farmConnection then
        Modules.Autofarm.farmConnection:Disconnect()
        Modules.Autofarm.farmConnection = nil
    end
    Modules.Autofarm.enabled = false
    restoreCharacter()
end

