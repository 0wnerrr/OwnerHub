local function stopAutofarmProcess()
    isFarming = false
    targetCoin = nil
    isResetting = false

    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end

    setNoclipState(false)
    disableAntiAfk()
    Player.DevCameraOcclusionMode = originalOcclusionMode

    local char, hrp, hum = getCharacterComponents()
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
end

local function startAutofarmProcess()
    if isFarming then return end
    isFarming = true
    isResetting = false

    enableAntiAfk()
    setNoclipState(true)
    Player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam

    local lastPosition = nil
    local lastBagCount = checkPlayerCoinBag()

    farmConnection = AddConnection(RunService.Heartbeat:Connect(function(deltaTime)
        if not isFarming or Modules.Config.AutoFarmCoins == false then
            stopAutofarmProcess()
            return
        end

        local char, hrp, hum = getCharacterComponents()
        if not char or not hrp or not hum then
            targetCoin = nil
            return
        end

        if isResetting then
            if tick() - resetStartTick > RESET_TIMEOUT_SECONDS then
                isResetting = false
            end
            return
        end

        local currentBag = checkPlayerCoinBag()
        if currentBag > lastBagCount then
            local gained = currentBag - lastBagCount
            totalSessionCoins = totalSessionCoins + gained
            lastBagCount = currentBag
        elseif currentBag < lastBagCount then
            lastBagCount = currentBag
        end

        if Modules.Config.AutoResetCoins and currentBag >= maxBagCapacity then
            targetCoin = nil
            resetCharacterPhysically()
            return
        end

        if not targetCoin or not targetCoin.Parent then
            targetCoin = findNearestCoin(hrp.Position)
        end

        if not targetCoin or not targetCoin.Parent then
            hrp.Velocity = Vector3.zero
            return
        end

        local coinPos = targetCoin.Position
        local flyTargetPos = coinPos - Vector3.new(0, FLY_BELOW_OFFSET, 0)

        local currentPos = hrp.Position
        local direction = (flyTargetPos - currentPos)
        local distance = direction.Magnitude

        if distance < 1.2 then
            hrp.CFrame = CFrame.new(flyTargetPos)
            hrp.Velocity = Vector3.zero

            if fireTouch then
                touchCoinDirect(hrp, targetCoin)
            end
            targetCoin = nil
        else
            local speed = Modules.Config.FarmSpeed or 25
            local step = math.min(distance, speed * deltaTime)
            local newPos = currentPos + (direction.Unit * step)

            hrp.CFrame = CFrame.new(newPos)
            hrp.Velocity = Vector3.zero

            if fireTouch and distance < 8 then
                touchCoinDirect(hrp, targetCoin)
            end
        end
    end))
end

do
    function Modules.ToggleAutoFarmCoins(enable)
        Modules.Config.AutoFarmCoins = enable

        if not enable then
            stopAutofarmProcess()
            return
        end

        startAutofarmProcess()
    end
end

