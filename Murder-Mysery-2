        or (typeof(firetouchtransmitter) == "function" and firetouchtransmitter)
        or nil,
    
    -- Internal state
    coinSet = {},
    trackedContainers = {},
    detectedPickupNames = {},
    lenientContainers = {},
    coinBlacklist = {},
    deadCoins = {},
    coinHadVisual = {},
    coinTouchFails = {},
    currentTarget = nil,
    farmConnection = nil,
    cameraConnection = nil,
    collisionCache = {},
    lastRadarSweep = 0,
