-- AutoFarm Logic
local farmingConnection
local function startAutoFarm()
    if farmingConnection then farmingConnection:Disconnect() end
    
    farmingConnection = RunService.Heartbeat:Connect(function()
        if not Config.AutoFarmEnabled then return end
        
        pcall(function()
            local char = player.Character
            if not char then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            -- Anti-AFK Movement
            if Config.AntiAFK then
                root.CFrame = root.CFrame + Vector3.new(0, 0.1, 0)
            end
        end)
    end)
end

-- Toggle AutoFarm with F key
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        Config.AutoFarmEnabled = not Config.AutoFarmEnabled
        print("[Vision Hub] AutoFarm: " .. (Config.AutoFarmEnabled and "ON" or "OFF"))
    end
    
    if input.KeyCode == Enum.KeyCode.G then
        print("[Vision Hub] Status: Active")
    end
end)

-- Start AutoFarm monitoring
startAutoFarm()

print("[Vision Hub] Loaded Successfully! ✓")
print("Press F to toggle AutoFarm")
print("Press G to show status")
