-- MM2 AutoFarm v2.0 - Простой и рабочий скрипт
-- Работает на всех современных executors

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- ==================== КОНФИГ ====================
local Config = {
    AutoFarm = false,
    FarmSpeed = 50,
    AntiAFK = true,
    ShowNotifications = true,
}

local GameState = {
    Alive = true,
    FarmingActive = false,
    CoinCount = 0,
    LastUpdate = tick(),
}

-- ==================== УТИЛИТЫ ====================

local function Print(text)
    print("[MM2 AutoFarm] " .. text)
    if Config.ShowNotifications then
        game.StarterGui:SetCore("SendNotification", {
            Title = "MM2 AutoFarm",
            Text = text,
            Duration = 3,
            Icon = "rbxassetid://6031075938"
        })
    end
end

local function GetCoinContainer()
    local workspace = game.Workspace
    for _, model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and (model.Name == "CoinContainers" or model.Name == "coins" or string.find(model.Name:lower(), "coin")) then
            return model
        end
    end
    return nil
end

local function GetNearestCoin()
    local container = GetCoinContainer()
    if not container then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, coin in ipairs(container:GetDescendants()) do
        if coin:IsA("BasePart") then
            local dist = (coin.Position - RootPart.Position).Magnitude
            if dist < nearestDist and dist < 200 then
                nearest = coin
                nearestDist = dist
            end
        end
    end
    
    return nearest
end

local function Teleport(position)
    if RootPart and RootPart.Parent then
        RootPart.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end
end

local function TouchCoin(coin)
    if coin and coin.Parent then
        if typeof(firetouchinterest) == "function" then
            firetouchinterest(coin, RootPart, 0)
            task.wait(0.05)
            firetouchinterest(coin, RootPart, 1)
        end
    end
end

local function UpdateCharacterReference()
    Character = Player.Character
    if Character then
        Humanoid = Character:FindFirstChild("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")
    end
end

-- ==================== AUTOFARM ====================

local FarmConnection = nil

local function StartAutoFarm()
    if FarmConnection then FarmConnection:Disconnect() end
    
    Config.AutoFarm = true
    GameState.FarmingActive = true
    Print("AutoFarm включен ✓")
    
    FarmConnection = RunService.Heartbeat:Connect(function()
        if not Config.AutoFarm then return end
        
        UpdateCharacterReference()
        
        if not Character or not Humanoid or Humanoid.Health <= 0 then
            Config.AutoFarm = false
            GameState.FarmingActive = false
            Print("Вы умерли. AutoFarm отключен.")
            if FarmConnection then FarmConnection:Disconnect() end
            return
        end
        
        local coin = GetNearestCoin()
        if coin and coin.Parent then
            local coinPos = coin.Position
            local distance = (coinPos - RootPart.Position).Magnitude
            
            if distance > 0.5 then
                -- Движение к монете
                Teleport(coinPos)
            else
                -- Касание монеты
                TouchCoin(coin)
                GameState.CoinCount = GameState.CoinCount + 1
            end
        end
    end)
end

local function StopAutoFarm()
    Config.AutoFarm = false
    GameState.FarmingActive = false
    if FarmConnection then 
        FarmConnection:Disconnect()
        FarmConnection = nil
    end
    Print("AutoFarm отключен ✗")
end

-- ==================== ГОРЯЧИЕ КЛАВИШИ ====================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        if Config.AutoFarm then
            StopAutoFarm()
        else
            StartAutoFarm()
        end
    end
    
    if input.KeyCode == Enum.KeyCode.G then
        Print("Монет собрано: " .. GameState.CoinCount)
    end
end)

-- ==================== ОБНОВЛЕНИЯ ПЕРСОНАЖА ====================

Player.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
    
    if Config.AutoFarm then
        Print("Персонаж возрожден. AutoFarm продолжается.")
    end
end)

-- ==================== ANTI-AFK ====================

if Config.AntiAFK then
    local AfkCounter = 0
    RunService.Heartbeat:Connect(function()
        AfkCounter = AfkCounter + 1
        if AfkCounter >= 300 then -- каждые 5 секунд
            if RootPart then
                RootPart.Position = RootPart.Position + Vector3.new(0.1, 0, 0)
            end
            AfkCounter = 0
        end
    end)
end

-- ==================== ИНИЦИАЛИЗАЦИЯ ====================

Print("Скрипт загружен! ✓")
Print("Нажимите F для включения/выключения AutoFarm")
Print("Нажимите G для просмотра статистики")
Print("")
Print("Версия: 2.0")
Print("Разработчик: v0 AI")
Print("")
Print("🎮 Готов к использованию!")

return {
    StartAutoFarm = StartAutoFarm,
    StopAutoFarm = StopAutoFarm,
    Config = Config,
    GameState = GameState
}
